        items = [json.loads(l) for l in content.splitlines() if l.strip()]
        groups = {"bug": [], "request": [], "praise": [], "other": []}
        for it in items:
            g = groups.setdefault(it.get("kind", "other"), [])
            for e in g:
                if difflib.SequenceMatcher(None, e["text"].lower(), it["text"].lower()).ratio() > 0.85: e["count"] += 1; break
            else: g.append({"text": it["text"], "bot": it.get("b"), "count": 1})
        print(json.dumps(groups, indent=1))
    elif a == ["preview"]:
        print(json.dumps({"batch": [o for _, o in pending(c)]}, indent=1))
    elif a == ["shared"]:
        for r in c.execute("SELECT at,wk,http,result,lines FROM hive_sends ORDER BY id"): print(json.dumps(dict(zip(["at", "wk", "http", "result", "lines"], r))))
    elif a in (["on"], ["off"]):
        meta(c, "sharing", a[0]); print("Hive Mind sharing", a[0])
    elif a == ["status"]:
        n = c.execute("SELECT count(*) FROM hive_items WHERE status='new'").fetchone()[0]
        print(json.dumps({"sharing": meta(c, "sharing") or "off", "pending": n, "last_week_sent": meta(c, "last_wk"), "intake": URL, "update_version": meta(c, "update_version")}))
    elif a == ["auto"]:
        if (meta(c, "sharing") or "off") != "on": print("sharing is off; nothing sent"); return 0
        if meta(c, "last_wk") == week(): print("already sent this week"); return 0
        items = pending(c)
        if not items: print("nothing to send"); return 0
        code, res, body = post_json(URL, {"batch": [o for _, o in items]})
        c.execute("INSERT INTO hive_sends(at,wk,lines,http,result) VALUES(?,?,?,?,?)", (now_iso(), week(), body.decode(), code, res))
        if code == 200 or code == 429:
            meta(c, "last_wk", week())
