        code, res, body = post_json(URL.rstrip("/") + "/feedback", item)
        c.execute("INSERT INTO hive_sends(at,wk,lines,http,result) VALUES(?,?,?,?,?)", (now_iso(), week(), body.decode(), code, res)); c.commit()
